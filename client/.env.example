# Backend API base URL. Defaults to http://localhost:4000 (lib/api.ts) if unset, so this
# is only needed to point at a non-default backend (e.g. the deployed Render URL).
VITE_API_URL=http://localhost:4000

# Google Maps JavaScript API key (Maps JavaScript API + Places API enabled), from
# https://console.cloud.google.com/google/maps-apis/credentials. Required — the map
# renders an error state without it. Restrict the key to your dev/prod origins.
VITE_GOOGLE_MAPS_API_KEY=

# Optional: a Map ID from Cloud Console > Google Maps Platform > Map Management, needed
# for custom map styling and required by Advanced Markers in production. Leave unset to
# fall back to Google's "DEMO_MAP_ID" (testing only, don't ship it — see components/Map.tsx).
VITE_GOOGLE_MAPS_MAP_ID=
