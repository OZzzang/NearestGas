# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Server port (optional — defaults to 4000)
PORT=4000

# MongoDB Atlas connection string (free M0 cluster)
# e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nearestgas
MONGODB_URI=

# Anthropic API key — powers the Claude Haiku 4.5 chatbot
ANTHROPIC_API_KEY=

# API key for the chosen Canadian fuel-price provider (Barchart OnDemand, Apify, etc.)
FUEL_API_KEY=

# Frontend origin allowed to call this API (CORS). The Vite dev server default is below;
# set this to your deployed Render static site URL in production.
CLIENT_ORIGIN=http://localhost:5173
