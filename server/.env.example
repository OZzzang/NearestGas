# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Server port (optional — defaults to 4000)
PORT=4000

# MongoDB Atlas connection string (free M0 cluster)
# e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nearestgas
MONGODB_URI=

# Gemini API key (from aistudio.google.com) — powers the chatbot (model is CHAT_MODEL
# in src/lib/gemini.ts, currently gemini-3.5-flash)
GEMINI_API_KEY=

# Google Geocoding API key (Cloud Console > APIs & Services > Credentials — enable the
# "Geocoding API" first). Separate from the client's VITE_GOOGLE_MAPS_API_KEY: this one
# is called server-side, so restrict it by API (Geocoding API only) rather than by HTTP
# referrer. Powers GET /api/geocode (typed-address search) — see geocodeService.ts for
# why this isn't Nominatim anymore.
GOOGLE_GEOCODING_API_KEY=

# Optional — the active fuel-price provider (Gas Quebec) is free and unauthenticated,
# so this isn't needed. Kept for a future provider that does require a key.
FUEL_API_KEY=

# Frontend origin allowed to call this API (CORS). The Vite dev server default is below;
# set this to your deployed Render static site URL in production.
CLIENT_ORIGIN=http://localhost:5173
